<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="動画の保存先"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="録画は常に公開のDownload/camフォルダへ直接保存されます(Android/data配下のアプリ専用フォルダは使用しません)。加えて、別のフォルダを指定すると、録画完了ごとにそちらへも追加コピーされます。"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textCurrentLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="現在の設定: アプリ専用フォルダのみ"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/buttonChooseFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="追加コピー先フォルダを選択" />

    <Button
        android:id="@+id/buttonClearFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="追加コピーの設定を解除" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="使用するレンズ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textLensDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="この端末で選択可能なレンズを確認中..."
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radioGroupLens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="録画に使用する容量の上限"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="通常のループ録画(dashcam_loop)が使用する合計容量の上限です。超えると古い録画から自動的に削除されます。保護されたイベント映像は対象外です。"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerCapacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="検知の閾値"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="値を大きくするほど鈍感(検知しにくく)、小さくするほど敏感(誤検知しやすく)なります。"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textShockDrivingValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="走行中の衝撃検知: 0.5G" />

    <SeekBar
        android:id="@+id/seekShockDriving"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="49"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textShockParkingValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="駐車監視中の衝撃検知: 0.2G" />

    <SeekBar
        android:id="@+id/seekShockParking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="49"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textTailgatingValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="急ブレーキ(煽り運転の可能性)検知: 0.3G" />

    <SeekBar
        android:id="@+id/seekTailgating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="19"
        android:layout_marginBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="駐車中の動体検知録画"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="駐車中は通常録画を停止し、動きを検知したときだけ録画を開始、動きが止まって15秒経過したら停止します。オフにすると駐車中も常時録画を続けます。"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/checkParkingMotion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="駐車中の動体検知録画を有効にする" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="終了時の確認"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/checkConfirmOnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="「終了」ボタンを押したとき確認ダイアログを表示する" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="画面の疑似消灯"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="メイン画面を表示したまま一定時間操作がないと、輝度を下げて黒いオーバーレイを重ねます(バッテリー節約)。タップすると復帰します。"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerScreenTimeout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="走行再生の地図"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radioMapProvider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioMapOsm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenStreetMap(標準・キー不要)" />

        <RadioButton
            android:id="@+id/radioMapGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Google マップ(APIキーが必要)" />
    </RadioGroup>

    <EditText
        android:id="@+id/editGoogleKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Google Maps JavaScript API キー"
        android:inputType="textNoSuggestions"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="※ どちらも地図の表示に通信が必要です。OpenStreetMapは公開タイルサーバーを使うため、個人の軽い利用に限ります。Googleマップは、Google Cloudでの請求先設定とAPIキーの発行が必要で、利用量によっては課金されます。キーはこの端末内にのみ保存されます。"
        android:textSize="12sp" />

</LinearLayout>
</ScrollView>
